# Local environment for this repository. Copy to `.env` (git-ignored) and fill in:
#
#   cp .env.example .env
#
# scripts/1_download_models.sh and scripts/2_run_inference.sh load `.env`
# automatically; a variable already set in the shell wins over the value here.
# Plain KEY=value lines only — no quotes, no spaces around `=`.

# ── Secrets ───────────────────────────────────────────────────────────────
# Hugging Face access token for the gated PIA-SPACE-LAB/SSAVE model repo.
# Needed only by scripts/1_download_models.sh, and only when the .onnx files are
# not already in assets/models/. Never commit the real token.
HF_TOKEN=

# ── Optional runtime defaults (uncomment to override) ─────────────────────
# infer.py mode for scripts/2_run_inference.sh: multi (cameras linked by global id,
# the default) or single (each clip on its own).
#MODE=multi

# GPU to run on (passed to infer.py as --device).
# DEVICE=cuda:0

# Output directory for scripts/2_run_inference.sh (default: runs/<input name>).
#OUT=runs/demo

# Config file for scripts/2_run_inference.sh (default: config/tracking.yaml).
#CONFIG=config/tracking.yaml

# Extra flags appended to infer.py by scripts/2_run_inference.sh,
# e.g. --no-video --show-conf --final-labels
#EXTRA=
